{
	"name": "apigate",
	"type": "module",
	"version": "1.6.0",
	"engines": {
		"node": ">=24 <25"
	},
	"packageManager": "pnpm@8.15.4",
	"description": "ODB API gate",
	"main": "index.mjs",
	"scripts": {
		"start": "export NODE_OPTIONS=--max_old_space_size=8192 && node --watch ./src/index.mjs",
		"prod": "export NODE_OPTIONS=--max_old_space_size=8192 && export NODE_ENV=production && node ./src/index.mjs",
		"test": "node --test tests/*.test.mjs"
	},
	"keywords": [
		"fastify",
		"ODB",
		"API"
	],
	"repository": "https://github.com/cywhale/apigate",
	"author": "cywhale",
	"license": "MIT",
	"dependencies": {
		"@fastify/autoload": "^6.5.0",
		"@fastify/cors": "^10.1.0",
		"@fastify/env": "^5.0.3",
		"@fastify/swagger": "^9.8.1",
		"@fastify/swagger-ui": "^6.1.1",
		"desm": "^1.3.1",
		"fastify": "^5.12.3",
		"fastify-plugin": "^5.1.0",
		"fluent-json-schema": "5.0.0",
		"knex": "^3.3.0",
		"lru-cache": "^11.5.2",
		"tedious": "^20.3.0"
	}
}
